# Hugging Face token (required for gated models like Phi-3.5)
HF_TOKEN=your-hf-token

# Groq API key (required for the judge)
GROQ_API_KEY=your-groq-api-key

# Frames per second to extract from each video
FPS=1

# Number of frames per VLM inference chunk
CHUNK_SIZE=5

# Overlapping frames between consecutive chunks (must be < CHUNK_SIZE)
CHUNK_OVERLAP=0

# VLM keys to run (space-separated list)
MODELS=["phi3_v", "qwen2_vl"]

# Set to true to skip GPU loading and return placeholder answers (for testing)
MOCK_INFERENCE=false

# Maximum number of videos to process from the videos directory (0 = no limit)
MAX_VIDEOS=0

# Score threshold for pass/fail classification (judgements >= this are "pass")
PASS_THRESHOLD=0.5

# Override HuggingFace cache directory (useful when root volume is small, e.g. on SageMaker)
# HF_HOME=/home/ec2-user/SageMaker/.cache/huggingface
